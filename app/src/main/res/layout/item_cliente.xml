<?xml version="1.0" encoding="utf-8"?>

<!--
    ESTRUCTURA (FrameLayout apila 3 capas):
      1. MaterialCardView  → card principal, con margen top y bottom para los flotantes
      2. ImageView avatar  → flota en el borde superior centrado
      3. btnVerDetalle     → flota en el borde inferior derecho

    El color del borde de la card y el fondo de tvEstado se setean dinámicamente
    desde el Adapter según el estado del cliente.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <!-- ══════════════════════════════
                    CARD
         ══════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="18dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeWidth="2dp"
        app:strokeColor="#D0D5DD"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            android:background="@color/surface_primary"
            android:gravity="center_horizontal">

            <!-- NOMBRE + APELLIDO -->
            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Juan Pérez" />

            <!-- ESTADO — pegado al borde izquierdo, redondeado solo a la derecha -->
            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingVertical="4dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_estado_left"
                tools:text="Nuevo Cliente" />

            <!-- CONTADORES: ventas pagadas y ventas pendientes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center">

                <!-- Ventas pagadas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/strokeBorder"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_primary">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:background="@color/surface_primary"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_ventas"
                            app:tint="#4A90E2" />
                        <TextView
                            android:id="@+id/tvVentasPagadas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            tools:text="3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ventas pendientes -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/strokeBorder"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_primary">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@color/surface_primary"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_bell"
                            app:tint="#F79009" />
                        <TextView
                            android:id="@+id/tvVentasPendientes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            tools:text="1" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════
            AVATAR — borde superior
         ══════════════════════════════ -->
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|center_horizontal"
        android:src="@drawable/ic_person"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:elevation="4dp"
        android:background="@drawable/bg_avatar_circle" />

    <!-- ══════════════════════════════
         BOTÓN — borde inferior derecho
         ══════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnVerDetalle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="#EBEBEB"
        app:cardElevation="4dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_toggle"
            app:tint="#4A4A4A" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>