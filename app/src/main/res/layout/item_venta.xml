<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="18dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeWidth="2dp"
        app:strokeColor="#D0D5DD"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="36dp"
            android:paddingBottom="16dp"
            android:gravity="center_horizontal">

            <!-- Número de venta -->
            <TextView
                android:id="@+id/tvVentaId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Venta #12" />

            <!-- Nombre del cliente -->
            <TextView
                android:id="@+id/tvClienteId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/hint_color"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                tools:text="Juan Pérez" />

            <!-- Estado — pegado al borde izquierdo -->
            <TextView
                android:id="@+id/tvEstadoVenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingVertical="4dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_estado_left"
                tools:text="Pendiente" />

            <!-- Monto total -->
            <TextView
                android:id="@+id/tvMonto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="$50.000" />

            <!-- Progreso de pago -->
            <ProgressBar
                android:id="@+id/progressPago"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:progress="60" />

            <!-- Fecha de seguimiento -->
            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="10sp"
                android:textColor="@color/hint_color"
                tools:text="Seguimiento: 30/04/2026" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Ícono de venta — borde superior -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|center_horizontal"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="#EBF1FF"
        app:cardElevation="4dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_ventas"
            app:tint="#286DFF" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Botón detalle — borde inferior derecho -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnVerDetalleVenta"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="#EBEBEB"
        app:cardElevation="4dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_toggle"
            app:tint="#4A4A4A" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
