<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FollowUp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/surface_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxStrokeColor">@color/primary_blue</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FollowUp.Dialog</item>
    </style>

    <style name="ThemeOverlay.FollowUp.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/surface_primary</item>
    </style>

    <style name="Dialog_FollowUp" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/surface_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Dialog_FollowUp.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Dialog_FollowUp.Button.Negative</item>
    </style>

    <style name="Dialog_FollowUp.Button.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_blue</item>
    </style>

    <style name="Dialog_FollowUp.Button.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>