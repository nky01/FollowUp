<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Tema principal — DayNight significa que Android aplica automáticamente
        values/ en modo claro y values-night/ en modo oscuro.
    -->
    <style name="Theme.FollowUp" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Colores del sistema Material -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Fondo de la app -->
        <item name="android:windowBackground">@color/surface_primary</item>

        <!-- Colores de texto por defecto -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- TextInputLayout — borde y hint respetan el tema -->
        <item name="boxStrokeColor">@color/primary_blue</item>

        <!-- Dialogs usan superficie correcta -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FollowUp.Dialog</item>

    </style>

    <!-- Overlay para AlertDialogs — fondo correcto en modo oscuro -->
    <style name="ThemeOverlay.FollowUp.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/surface_primary</item>
    </style>


</resources>